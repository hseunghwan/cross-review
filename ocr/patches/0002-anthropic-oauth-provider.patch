+func writeClaudeTestPadding() bool {
+	padding := bytes.Repeat([]byte(" "), 1024*1024)
+	for range 33 {
+		if _, err := os.Stdout.Write(padding); err != nil {
+			return false
+		}
+	}
+	return true
+}
