+func runCoreTemplate(opts coreOptions) error {
+	tpl, err := template.LoadDefault()
+	if err != nil {
+		return fmt.Errorf("load default template: %w", err)
+	}
+	effort := template.EffortDefault
+	if opts.effort != "" {
+		if effort, err = template.ParseEffort(opts.effort); err != nil {
+			return err
+		}
+	}
+	tpl.ApplyEffort(effort)
+	limits := agent.Limits()
+	out := coreTemplateOutput{
+		Effort:                      string(effort),
+		MaxTokens:                   tpl.MaxTokens,
+		MaxCompletionTokens:         tpl.CompletionTokenLimit(),
+		MaxToolRequestTimes:         tpl.MaxToolRequestTimes,
+		PlanModeLineThreshold:       tpl.PlanModeLineThreshold,
+		PlanModeGroupLineThreshold:  tpl.PlanModeGroupLineThreshold,
+		GroupingMinFiles:            tpl.GroupingMinFiles,
+		GroupingBundleLineThreshold: tpl.GroupingBundleLineThreshold,
+		MaxReviewRounds:             tpl.ReviewRounds(),
+		MaxFilesPerGroup:            limits.MaxFilesPerGroup,
+		ConfirmedCap:                limits.ConfirmedCap,
+		ConfirmedMaxExistingCode:    limits.ConfirmedMaxExistingCode,
+		ConfirmedMaxContent:         limits.ConfirmedMaxContent,
+		SmallChangeSetLabel:         limits.SmallChangeSetLabel,
+		MainTaskTools:               append([]string{}, tpl.MainTask.Tools...),
+		PlanToolReferences:          []string{},
+		PromptPhases:                corePhases,
+	}
+	if tpl.PlanTask != nil {
+		out.PlanToolReferences = append(out.PlanToolReferences, tpl.PlanTask.ToolReferences...)
+	}
+	for _, d := range agent.FilterToolDefs() {
+		out.FilterTools = append(out.FilterTools, d.Function.Name)
+	}
+	return writeCoreJSON(out)
+}
