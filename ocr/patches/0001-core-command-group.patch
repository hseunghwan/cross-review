+	}
+	if coreOptsFor(coreRenderCmd) != &coreRenderOpts || coreOptsFor(coreGroupCmd) != &coreGroupOpts || coreOptsFor(coreDiffCmd) != &coreDiffOpts {
+		t.Fatal("coreOptsFor")
+	}
+}
