+// loadCoreSet resolves the repository, rules and template, then loads the
+// change set with the review's own selection.
+func loadCoreSet(opts coreOptions) (*commonContext, *agent.CoreDiffSet, error) {
+	if err := validateDiffMode(opts.from, opts.to, opts.commit); err != nil {
+		return nil, nil, err
+	}
+	contentRef, _ := tool.ParseReviewMode(opts.from, opts.to, opts.commit).RefValue(opts.to, opts.commit)
+	cc, err := loadCommonContext(opts.repoDir, opts.rulePath, contentRef, 0, opts.maxGitProcs, true)
+	if err != nil {
+		return nil, nil, err
+	}
+	applyCLIExcludes(cc, splitPaths(opts.excludes))
+	if opts.maxTokens > 0 {
+		cc.Template.MaxTokens = opts.maxTokens
+	}
+	if err := validateReviewRefs(cc.RepoDir, reviewOptions{from: opts.from, to: opts.to, commit: opts.commit}); err != nil {
+		return nil, nil, err
+	}
+	set, err := agent.CoreDiffs(context.Background(), coreAgentArgs(cc, opts))
+	if err != nil {
+		return nil, nil, err
+	}
+	return cc, set, nil
+}
+
+func coreAgentArgs(cc *commonContext, opts coreOptions) agent.Args {
