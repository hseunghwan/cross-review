+// runCore captures what a core runner writes to coreOutput.
+func runCore(t *testing.T, fn func() error) ([]byte, error) {
+	t.Helper()
+	var buf bytes.Buffer
+	orig := coreOutput
+	coreOutput = &buf
+	defer func() { coreOutput = orig }()
+	err := fn()
+	return buf.Bytes(), err
+}
+
+func decodeCore[T any](t *testing.T, data []byte) T {
+	t.Helper()
+	var v T
+	if err := json.Unmarshal(data, &v); err != nil {
+		t.Fatalf("decode core JSON: %v\n%s", err, data)
+	}
+	return v
+}
