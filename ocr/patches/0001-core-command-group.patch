+// coreRangeRepo builds a repo whose HEAD~1..HEAD range modifies, adds and
+// deletes files, and returns the repo dir.
+func coreRangeRepo(t *testing.T) string {
+	t.Helper()
+	freshOCRHome(t)
+	dir := initTestGitRepo(t)
+	writeRepoFile(t, dir, "calc.go", "package calc\n\nfunc Div(a, b int) int {\n\tif b == 0 {\n\t\treturn 0\n\t}\n\treturn a / b\n}\n")
+	writeRepoFile(t, dir, "old.py", "def old():\n    return 1\n")
+	gitRun(t, dir, "add", ".")
+	gitRun(t, dir, "commit", "-m", "base")
+	writeRepoFile(t, dir, "calc.go", "package calc\n\nfunc Div(a, b int) int {\n\treturn a / b\n}\n\nfunc Mul(a, b int) int {\n\treturn a * b\n}\n")
+	writeRepoFile(t, dir, "new.js", "export function f(x) {\n  return eval(x);\n}\n")
+	gitRun(t, dir, "rm", "-q", "old.py")
+	gitRun(t, dir, "add", ".")
+	gitRun(t, dir, "commit", "-m", "change")
+	return dir
+}
