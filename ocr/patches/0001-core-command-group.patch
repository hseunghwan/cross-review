+func runCoreRule(opts coreOptions, path string) error {
+	cc, err := loadCommonContext(opts.repoDir, opts.rulePath, "", 0, 16, false)
+	if err != nil {
+		return err
+	}
+	rule := ""
+	if cc.Resolver != nil {
+		rule = cc.Resolver.Resolve(path)
+	}
+	_, err = fmt.Fprintln(coreOutput, rule)
+	return err
+}
