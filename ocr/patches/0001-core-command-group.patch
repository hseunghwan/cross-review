diff --git a/internal/agent/core.go b/internal/agent/core.go
new file mode 100644
index 0000000..24d7f4a
--- /dev/null
+++ b/internal/agent/core.go
@@ -0,0 +1,276 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright 2026 alibaba/open-code-review Contributors
+
+package agent
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/alibaba/open-code-review/internal/config/template"
+	"github.com/alibaba/open-code-review/internal/diff"
+	"github.com/alibaba/open-code-review/internal/llm"
+	"github.com/alibaba/open-code-review/internal/llmloop"
+	"github.com/alibaba/open-code-review/internal/model"
+)
+
+// The helpers in this file back the `ocr core` command group: the review
+// pipeline's deterministic steps exposed one by one so an external brain can
+// drive the review while reaching the same selection, grouping, prompt and
+// filter inputs as `ocr review`. None of them calls an LLM, and none of them
+// writes progress output, because their callers print JSON on stdout.
+
+// CoreFile is one changed file together with the selection verdict the review
+// itself would reach for it.
+type CoreFile struct {
+	Diff          model.Diff
+	Path          string
+	Status        string
+	WillReview    bool
+	ExcludeReason ExcludeReason
+}
+
+// CoreDiffSet is the full change set in provider order. Selected holds the
+// files the review dispatches; Retained adds deletions, which never get
+// reviewed but still appear in the change-file list the prompts show.
+type CoreDiffSet struct {
+	Files           []CoreFile
+	Selected        []model.Diff
+	Retained        []model.Diff
+	TotalInsertions int64
+	TotalDeletions  int64
+	MergeBase       string
+}
+
+// CoreDiffs loads the change set and applies the same selection `--preview`
+// and the real run use. args needs RepoDir, the diff refs, GitRunner, Template
+// (MaxTokens drives the size gate) and FileFilter (user include/exclude rules).
+func CoreDiffs(ctx context.Context, args Args) (*CoreDiffSet, error) {
+	a := &Agent{args: args}
+	set, err := a.loadPreviewDiffs(ctx)
+	if err != nil {
+		return nil, fmt.Errorf("load diffs: %w", err)
+	}
+	out := &CoreDiffSet{TotalInsertions: a.totalInsertions, TotalDeletions: a.totalDeletions}
+	decisions := a.selectFiles(a.diffs)
+	next := 0
+	set.ForEachInOrder(func(d model.Diff, providerExcluded bool) {
+		if providerExcluded {
+			out.TotalInsertions += d.Insertions
+			out.TotalDeletions += d.Deletions
+			out.Files = append(out.Files, CoreFile{
+				Diff: d, Path: effectivePath(d), Status: diffStatus(d),
+				ExcludeReason: ExcludeProviderDirectory,
+			})
+			return
+		}
+		dec := decisions[next]
+		next++
+		out.Files = append(out.Files, CoreFile{
+			Diff: dec.Diff, Path: effectivePath(dec.Diff), Status: diffStatus(dec.Diff),
+			WillReview: dec.selected(), ExcludeReason: dec.Reason,
+		})
+		if dec.selected() {
+			out.Selected = append(out.Selected, dec.Diff)
+		}
+		if dec.retained() {
+			out.Retained = append(out.Retained, dec.Diff)
+		}
+	})
+	if args.From != "" && args.To != "" {
+		out.MergeBase = diff.NewProvider(args.RepoDir, args.From, args.To, args.GitRunner).MergeBase(ctx)
+	}
+	return out, nil
+}
+
+// CoreLimits are the pipeline constants that are not template fields.
+type CoreLimits struct {
+	MaxFilesPerGroup         int
+	ConfirmedCap             int
+	ConfirmedMaxExistingCode int
+	ConfirmedMaxContent      int
+	SmallChangeSetLabel      string
+}
+
+// Limits returns the review pipeline's built-in constants.
+func Limits() CoreLimits {
+	return CoreLimits{
+		MaxFilesPerGroup:         maxFilesPerGroup,
+		ConfirmedCap:             confirmedCap,
+		ConfirmedMaxExistingCode: confirmedMaxExistingCode,
+		ConfirmedMaxContent:      confirmedMaxContent,
+		SmallChangeSetLabel:      smallChangeSetLabel,
+	}
+}
+
+// FilterToolDefs returns the tools the review filter phase offers the model.
+func FilterToolDefs() []llm.ToolDef {
+	return append([]llm.ToolDef(nil), filterTools...)
+}
+
+// CoreGroup is one review unit with the churn figures that gate its plan phase.
+type CoreGroup struct {
+	Label          string
+	Key            string
+	Diffs          []model.Diff
+	TotalChanged   int64
+	MaxFileChanged int64
+	PlanRequired   bool
+}
+
+// CoreGrouping is the outcome of the grouping step. When Strategy is
+// GroupingViaLLM and no response was supplied, Groups is empty and Messages
+// holds the grouping prompt the caller must answer.
+type CoreGrouping struct {
+	Strategy template.GroupingStrategy
+	Messages []llm.Message
+	Groups   []CoreGroup
+}
+
+// GroupForCore mirrors the review's grouping step over the selected files.
+// response is the grouping model's raw answer; pass "" to ask for the prompt.
+func GroupForCore(selected []model.Diff, tpl template.Template, response string) (*CoreGrouping, error) {
+	var nonDeleted []model.Diff
+	for _, d := range selected {
+		if !d.IsDeleted {
+			nonDeleted = append(nonDeleted, d)
+		}
+	}
+	tokenLimit := llmloop.PromptTokenLimit(tpl.MaxTokens)
+	totalChanged, _ := diffsChurn(nonDeleted)
+	strategy := template.GroupingPerFile
+	if len(nonDeleted) > 1 {
+		strategy = tpl.GroupingPlan(len(nonDeleted), totalChanged)
+		if strategy == template.GroupingViaLLM && (tpl.GroupingTask == nil || len(tpl.GroupingTask.Messages) == 0) {
+			strategy = template.GroupingPerFile
+		}
+	}
+
+	out := &CoreGrouping{Strategy: strategy}
+	var groups []FileGroup
+	switch strategy {
+	case template.GroupingBundleAll:
+		groups = enforceMaxFilesPerGroup([]FileGroup{{Label: smallChangeSetLabel, Diffs: nonDeleted}})
+		groups = enforceGroupTokenBudget(groups, tokenLimit)
+	case template.GroupingViaLLM:
+		if strings.TrimSpace(response) == "" {
+			fileList := buildFileList(nonDeleted)
+			for _, m := range tpl.GroupingTask.Messages {
+				out.Messages = append(out.Messages,
+					llm.NewTextMessage(m.Role, strings.ReplaceAll(m.Content, "{{file_list}}", fileList)))
+			}
+			return out, nil
+		}
+		parsed, err := parseGroupingResponse(response, nonDeleted)
+		if err != nil {
+			return nil, err
+		}
+		groups = enforceGroupTokenBudget(parsed, tokenLimit)
+	default:
+		groups = toSingleFileGroups(nonDeleted)
+	}
+
+	for _, g := range groups {
+		total, maxFile := diffsChurn(g.Diffs)
+		out.Groups = append(out.Groups, CoreGroup{
+			Label: g.Label, Key: fileGroupKey(g.Diffs), Diffs: g.Diffs,
+			TotalChanged: total, MaxFileChanged: maxFile,
+			PlanRequired: tpl.PlanRequired(len(g.Diffs), total, maxFile),
+		})
+	}
+	return out, nil
+}
+
+// CoreRender carries everything a prompt phase substitutes.
+type CoreRender struct {
+	Args      Args
+	Retained  []model.Diff
+	Group     []model.Diff
+	Now       time.Time
+	Plan      string
+	Confirmed []model.LlmComment
+	Comments  []model.LlmComment
+}
+
+func (r CoreRender) agent() *Agent {
+	now := r.Now
+	if now.IsZero() {
+		now = time.Now()
+	}
+	return &Agent{args: r.Args, diffs: r.Retained, currentDate: now.Format("2006-01-02 15:04")}
+}
+
+// RenderPlanMessages builds the plan phase prompt for a group exactly as the
+// review does.
+func RenderPlanMessages(r CoreRender) ([]llm.Message, error) {
+	pt := r.Args.Template.PlanTask
+	if pt == nil || len(pt.Messages) == 0 {
+		return nil, fmt.Errorf("template has no plan task")
+	}
+	a := r.agent()
+	diffs := buildConcatenatedDiffs(r.Group)
+	changeFiles := a.buildChangeFilesExceptGroup(r.Group)
+	rule := a.resolveGroupSystemRule(r.Group)
+	messages := make([]llm.Message, 0, len(pt.Messages))
+	for _, m := range pt.Messages {
+		content := m.Content
+		content = strings.ReplaceAll(content, "{{current_system_date_time}}", a.currentDate)
+		content = strings.ReplaceAll(content, "{{system_rule}}", rule)
+		content = strings.ReplaceAll(content, "{{change_files}}", changeFiles)
+		content = strings.ReplaceAll(content, "{{diffs}}", diffs)
+		content = strings.ReplaceAll(content, "{{requirement_background}}", a.args.Background)
+		content = strings.ReplaceAll(content, "{{plan_tools}}", formatToolDefs(a.args.PlanToolDefs))
+		messages = append(messages, llm.NewTextMessage(m.Role, content))
+	}
+	return messages, nil
+}
+
+// RenderMainMessages builds one main-review round's prompt for a group. Plan
+// applies only to the first round and Confirmed carries the findings earlier
+// rounds kept, matching executeGroupSubtask.
+func RenderMainMessages(r CoreRender) ([]llm.Message, error) {
+	if len(r.Args.Template.MainTask.Messages) == 0 {
+		return nil, errMainTaskEmpty
+	}
+	a := r.agent()
+	return a.buildMainTaskMessages(
+		a.resolveGroupSystemRule(r.Group),
+		a.buildChangeFilesExceptGroup(r.Group),
+		buildConcatenatedDiffs(r.Group),
+		r.Plan,
+		buildConfirmedCommentsBlock(r.Confirmed),
+	), nil
+}
+
+// RenderFilterMessages builds the review filter prompt for one round's new
+// candidate comments. Candidate i is addressed as "c-i" in the model's answer.
+func RenderFilterMessages(r CoreRender) ([]llm.Message, error) {
+	ft := r.Args.Template.ReviewFilterTask
+	if ft == nil || len(ft.Messages) == 0 {
+		return nil, fmt.Errorf("template has no review filter task")
+	}
+	groupKey := fileGroupKey(r.Group)
+	commentsJSON := buildGroupFilterCommentsJSON(r.Comments)
+	diffs := buildConcatenatedDiffs(r.Group)
+	messages := make([]llm.Message, 0, len(ft.Messages))
+	for _, m := range ft.Messages {
+		content := m.Content
+		content = strings.ReplaceAll(content, "{{path}}", groupKey)
+		content = strings.ReplaceAll(content, "{{diff}}", diffs)
+		content = strings.ReplaceAll(content, "{{comments}}", commentsJSON)
+		messages = append(messages, llm.NewTextMessage(m.Role, content))
+	}
+	return messages, nil
+}
+
+// RelocateExisting resolves a comment's existing_code to new-file lines with
+// the review's deterministic matcher. It never consults a model.
+func RelocateExisting(d model.Diff, existingCode string) (start, end int, matched bool) {
+	cm := model.LlmComment{ExistingCode: existingCode}
+	if !diff.ResolveComment(&cm, &d) {
+		return 0, 0, false
+	}
+	return cm.StartLine, cm.EndLine, true
+}
diff --git a/internal/agent/core_test.go b/internal/agent/core_test.go
new file mode 100644
index 0000000..1452825
--- /dev/null
+++ b/internal/agent/core_test.go
@@ -0,0 +1,201 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright 2026 alibaba/open-code-review Contributors
+
+package agent
+
+import (
+	"context"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/alibaba/open-code-review/internal/config/template"
+	"github.com/alibaba/open-code-review/internal/gitcmd"
+	"github.com/alibaba/open-code-review/internal/model"
+)
+
+func coreTemplate(t *testing.T) template.Template {
+	t.Helper()
+	tpl, err := template.LoadDefault()
+	if err != nil {
+		t.Fatalf("load template: %v", err)
+	}
+	return *tpl
+}
+
+func coreDiff(path string, lines int) model.Diff {
+	var body strings.Builder
+	body.WriteString("diff --git a/" + path + " b/" + path + "\n--- /dev/null\n+++ b/" + path + "\n")
+	for i := 0; i < lines; i++ {
+		body.WriteString("+line\n")
+	}
+	return model.Diff{OldPath: path, NewPath: path, Diff: body.String(), IsNew: true, Insertions: int64(lines)}
+}
+
+func TestGroupForCoreStrategies(t *testing.T) {
+	tpl := coreTemplate(t)
+	tpl.GroupingMinFiles = 4
+	tpl.GroupingBundleLineThreshold = 200
+
+	one, err := GroupForCore([]model.Diff{coreDiff("a.go", 60)}, tpl, "")
+	if err != nil || one.Strategy != template.GroupingPerFile || len(one.Groups) != 1 || !one.Groups[0].PlanRequired {
+		t.Fatalf("single file = %+v, %v", one, err)
+	}
+
+	deleted := model.Diff{OldPath: "gone.go", NewPath: "gone.go", IsDeleted: true}
+	small, err := GroupForCore([]model.Diff{coreDiff("a.go", 2), coreDiff("b.go", 2), deleted}, tpl, "")
+	if err != nil || small.Strategy != template.GroupingBundleAll || len(small.Groups) != 1 ||
+		small.Groups[0].Label != smallChangeSetLabel || small.Groups[0].Key != "a.go,b.go" {
+		t.Fatalf("small set = %+v, %v", small, err)
+	}
+
+	perFile, err := GroupForCore([]model.Diff{coreDiff("a.go", 150), coreDiff("b.go", 150)}, tpl, "")
+	if err != nil || perFile.Strategy != template.GroupingPerFile || len(perFile.Groups) != 2 {
+		t.Fatalf("per file = %+v, %v", perFile, err)
+	}
+
+	many := []model.Diff{coreDiff("a.go", 1), coreDiff("b.go", 1), coreDiff("c.go", 1), coreDiff("d.go", 1)}
+	ask, err := GroupForCore(many, tpl, "")
+	if err != nil || ask.Strategy != template.GroupingViaLLM || len(ask.Messages) == 0 || len(ask.Groups) != 0 {
+		t.Fatalf("llm prompt = %+v, %v", ask, err)
+	}
+	if !strings.Contains(ask.Messages[len(ask.Messages)-1].ExtractText(), "[3]") {
+		t.Fatal("grouping prompt lacks the indexed file list")
+	}
+
+	answered, err := GroupForCore(many, tpl, `[{"label":"x","files":[0,2]}]`)
+	if err != nil || len(answered.Groups) != 3 || answered.Groups[0].Key != "a.go,c.go" {
+		t.Fatalf("llm answer = %+v, %v", answered, err)
+	}
+	if _, err := GroupForCore(many, tpl, "not json"); err == nil {
+		t.Fatal("expected a parse error")
+	}
+
+	tpl.GroupingTask = nil
+	noTask, err := GroupForCore(many, tpl, "")
+	if err != nil || noTask.Strategy != template.GroupingPerFile || len(noTask.Groups) != 4 {
+		t.Fatalf("no grouping task = %+v, %v", noTask, err)
+	}
+}
+
+func TestRenderForCore(t *testing.T) {
+	tpl := coreTemplate(t)
+	group := []model.Diff{coreDiff("a.go", 3)}
+	retained := append([]model.Diff{coreDiff("other.go", 1)}, group...)
+	r := CoreRender{Args: Args{Template: tpl, Background: "BG"}, Retained: retained, Group: group,
+		Now: time.Date(2026, 1, 2, 3, 4, 0, 0, time.UTC), Plan: "THE-PLAN",
+		Confirmed: []model.LlmComment{{Path: "a.go", Content: "seen"}},
+		Comments:  []model.LlmComment{{Path: "a.go", Content: "candidate"}}}
+
+	main, err := RenderMainMessages(r)
+	if err != nil {
+		t.Fatalf("main: %v", err)
+	}
+	text := main[len(main)-1].ExtractText()
+	for _, want := range []string{"THE-PLAN", "seen", "BG", "2026-01-02 03:04", "other.go"} {
+		if !strings.Contains(text, want) {
+			t.Fatalf("main lacks %q", want)
+		}
+	}
+	if _, err := RenderPlanMessages(r); err != nil {
+		t.Fatalf("plan: %v", err)
+	}
+	filter, err := RenderFilterMessages(r)
+	if err != nil || !strings.Contains(filter[len(filter)-1].ExtractText(), `"c-0"`) {
+		t.Fatalf("filter = %v, %v", filter, err)
+	}
+
+	r.Now = time.Time{}
+	if _, err := RenderMainMessages(r); err != nil {
+		t.Fatalf("main with default clock: %v", err)
+	}
+	empty := r
+	empty.Args.Template = template.Template{}
+	if _, err := RenderMainMessages(empty); err == nil {
+		t.Fatal("expected an empty main task error")
+	}
+	if _, err := RenderPlanMessages(empty); err == nil {
+		t.Fatal("expected a missing plan task error")
+	}
+	if _, err := RenderFilterMessages(empty); err == nil {
+		t.Fatal("expected a missing filter task error")
+	}
+}
+
+func TestCoreSmallHelpers(t *testing.T) {
+	d := model.Diff{Diff: "diff --git a/x b/x\n--- a/x\n+++ b/x\n@@ -1 +1,2 @@\n a\n+b\n", NewFileContent: "a\nb\n"}
+	if s, e, ok := RelocateExisting(d, "b"); !ok || s != 2 || e != 2 {
+		t.Fatalf("relocate = %d,%d,%v", s, e, ok)
+	}
+	if _, _, ok := RelocateExisting(d, "zzz"); ok {
+		t.Fatal("relocate matched missing code")
+	}
+	if l := Limits(); l.MaxFilesPerGroup != maxFilesPerGroup || l.ConfirmedCap != confirmedCap {
+		t.Fatalf("limits = %+v", l)
+	}
+	defs := FilterToolDefs()
+	defs[0].Function.Name = "mutated"
+	if filterTools[0].Function.Name == "mutated" {
+		t.Fatal("FilterToolDefs must return a copy")
+	}
+}
+
+func TestCoreDiffsSelection(t *testing.T) {
+	dir := t.TempDir()
+	t.Setenv("GIT_CONFIG_GLOBAL", os.DevNull)
+	t.Setenv("GIT_CONFIG_SYSTEM", os.DevNull)
+	run := func(args ...string) {
+		t.Helper()
+		cmd := exec.Command("git", append([]string{"-C", dir}, args...)...)
+		if out, err := cmd.CombinedOutput(); err != nil {
+			t.Fatalf("git %v: %v: %s", args, err, out)
+		}
+	}
+	write := func(name, content string) {
+		t.Helper()
+		p := filepath.Join(dir, name)
+		if err := os.MkdirAll(filepath.Dir(p), 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(p, []byte(content), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	run("init", "-q")
+	run("config", "user.email", "t@t")
+	run("config", "user.name", "t")
+	write("keep.go", "package k\n")
+	write("drop.go", "package d\n")
+	write("vendor/v.go", "package v\n")
+	run("add", ".")
+	run("commit", "-qm", "base")
+	write("keep.go", "package k\n\nfunc K() {}\n")
+	write("vendor/v.go", "package v\n\nfunc V() {}\n")
+	run("rm", "-q", "drop.go")
+	run("add", ".")
+	run("commit", "-qm", "change")
+
+	set, err := CoreDiffs(context.Background(), Args{RepoDir: dir, From: "HEAD~1", To: "HEAD",
+		Template: coreTemplate(t), GitRunner: gitcmd.New(4)})
+	if err != nil {
+		t.Fatalf("CoreDiffs: %v", err)
+	}
+	reasons := map[string]ExcludeReason{}
+	for _, f := range set.Files {
+		reasons[f.Path] = f.ExcludeReason
+	}
+	if reasons["keep.go"] != ExcludeNone || reasons["drop.go"] != ExcludeDeleted || reasons["vendor/v.go"] != ExcludeProviderDirectory {
+		t.Fatalf("reasons = %v", reasons)
+	}
+	if len(set.Selected) != 1 || len(set.Retained) != 2 || set.MergeBase == "" {
+		t.Fatalf("selected=%d retained=%d mergeBase=%q", len(set.Selected), len(set.Retained), set.MergeBase)
+	}
+
+	if _, err := CoreDiffs(context.Background(), Args{RepoDir: filepath.Join(dir, "missing"),
+		Template: coreTemplate(t), GitRunner: gitcmd.New(1)}); err == nil {
+		t.Fatal("expected a load error for a missing repo")
+	}
+}
