+// decodeCoreComments accepts either a bare comment array or an object with a
+// "comments" array, plus optional "groups" for emit.
+func decodeCoreComments(data []byte) ([]model.LlmComment, []agent.FileGroupInfo, error) {
+	trimmed := strings.TrimSpace(string(data))
+	if strings.HasPrefix(trimmed, "[") {
+		var comments []model.LlmComment
+		if err := json.Unmarshal([]byte(trimmed), &comments); err != nil {
+			return nil, nil, err
+		}
+		return comments, nil, nil
+	}
+	var wrapped struct {
+		Comments []model.LlmComment    `json:"comments"`
+		Groups   []agent.FileGroupInfo `json:"groups"`
+	}
+	if err := json.Unmarshal([]byte(trimmed), &wrapped); err != nil {
+		return nil, nil, err
+	}
+	return wrapped.Comments, wrapped.Groups, nil
+}
+
+func runCoreEmit(in io.Reader) error {
+	data, err := io.ReadAll(in)
+	if err != nil {
+		return fmt.Errorf("read stdin: %w", err)
+	}
+	comments, groups, err := decodeCoreComments(data)
+	if err != nil {
+		return fmt.Errorf("parse stdin JSON: %w", err)
+	}
+	if comments == nil {
+		comments = []model.LlmComment{}
+	}
+	out := jsonOutput{
+		Status:    "success",
+		ToolCalls: newJSONToolCalls(nil, nil),
+		Comments:  comments,
+		Groups:    groups,
+	}
+	if len(comments) == 0 {
+		out.Message = "No comments generated. Looks good to me."
+	}
+	enc := json.NewEncoder(coreOutput)
+	enc.SetIndent("", "  ")
+	return enc.Encode(out)
+}
