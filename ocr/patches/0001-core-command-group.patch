+// coreExcludeReason keeps the reason spelling earlier core consumers parse.
+// The review calls an oversized diff "too_large"; core has always said
+// "large_diff". Every other reason passes through unchanged.
+func coreExcludeReason(r agent.ExcludeReason) string {
+	if r == agent.ExcludeTooLarge {
+		return "large_diff"
+	}
+	return string(r)
+}
+
+func coreHunks(raw string) []coreHunk {
+	parsed := diff.ParseHunks(raw)
+	out := make([]coreHunk, 0, len(parsed))
+	for _, h := range parsed {
+		lines := make([]coreHunkLine, 0, len(h.Lines))
+		for _, l := range h.Lines {
+			t := "context"
+			switch l.Type {
+			case diff.HunkAdded:
+				t = "added"
+			case diff.HunkDeleted:
+				t = "deleted"
+			}
+			lines = append(lines, coreHunkLine{Type: t, Content: l.Content})
+		}
+		out = append(out, coreHunk{OldStart: h.OldStart, OldCount: h.OldCount, NewStart: h.NewStart, NewCount: h.NewCount, Lines: lines})
+	}
+	return out
+}
+
+func runCoreDiff(opts coreOptions) error {
+	_, set, err := loadCoreSet(opts)
+	if err != nil {
+		return err
+	}
+	out := coreDiffOutput{
+		Mode: coreMode(opts), From: opts.from, To: opts.to, Commit: opts.commit, MergeBase: set.MergeBase,
+		TotalFiles: len(set.Files), TotalInsertions: set.TotalInsertions, TotalDeletions: set.TotalDeletions,
+		Files: make([]coreDiffFile, 0, len(set.Files)),
+	}
+	for _, f := range set.Files {
+		entry := coreDiffFile{
+			Path: f.Path, Status: f.Status,
+			Insertions: f.Diff.Insertions, Deletions: f.Diff.Deletions,
+			ChangedLines: f.Diff.Insertions + f.Diff.Deletions,
+			WillReview:   f.WillReview, ExcludeReason: coreExcludeReason(f.ExcludeReason),
+		}
+		if f.Diff.OldPath != "" && f.Diff.OldPath != "/dev/null" && f.Diff.OldPath != f.Path {
+			entry.OldPath = f.Diff.OldPath
+		}
+		if f.WillReview {
+			out.ReviewableCount++
+			content := f.Diff.NewFileContent
+			entry.Diff = f.Diff.Diff
+			entry.NewFileContent = &content
+			entry.Hunks = coreHunks(f.Diff.Diff)
+		} else {
+			out.ExcludedCount++
+		}
+		out.Files = append(out.Files, entry)
+	}
+	return writeCoreJSON(out)
+}
