+func runCoreGroup(opts coreOptions) error {
+	cc, set, err := loadCoreSet(opts)
+	if err != nil {
+		return err
+	}
+	response := ""
+	if opts.responseFile != "" {
+		data, err := os.ReadFile(opts.responseFile)
+		if err != nil {
+			return fmt.Errorf("read --response-file: %w", err)
+		}
+		response = string(data)
+	}
+	grouping, err := agent.GroupForCore(set.Selected, *cc.Template, response)
+	if err != nil {
+		return err
+	}
+	out := coreGroupOutput{Strategy: grouping.Strategy.String(), Groups: []coreGroupJSON{}}
+	if len(grouping.Messages) > 0 {
+		out.NeedsAnswer = true
+		out.Messages = grouping.Messages
+	}
+	for _, g := range grouping.Groups {
+		files := make([]string, 0, len(g.Diffs))
+		for _, d := range g.Diffs {
+			files = append(files, d.NewPath)
+		}
+		out.Groups = append(out.Groups, coreGroupJSON{
+			Label: g.Label, Key: g.Key, Files: files,
+			TotalChanged: g.TotalChanged, MaxFileChanged: g.MaxFileChanged, PlanRequired: g.PlanRequired,
+		})
+	}
+	return writeCoreJSON(out)
+}
+
+type coreFilterID struct {
+	ID   string `json:"id"`
+	Path string `json:"path"`
+}
+
+type coreRenderOutput struct {
+	Phase      string         `json:"phase"`
+	GroupKey   string         `json:"group_key"`
+	Files      []string       `json:"files"`
+	Messages   []llm.Message  `json:"messages"`
+	Tools      []llm.ToolDef  `json:"tools,omitempty"`
+	CommentIDs []coreFilterID `json:"comment_ids,omitempty"`
+}
+
+func readCoreCommentsFile(path string) ([]model.LlmComment, error) {
+	if path == "" {
+		return nil, nil
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, err
+	}
+	comments, _, err := decodeCoreComments(data)
+	return comments, err
+}
+
+// pickCoreGroup returns the selected diffs named by --files, in the order given.
+func pickCoreGroup(selected []model.Diff, files string) ([]model.Diff, error) {
+	want := splitPaths(files)
+	if len(want) == 0 {
+		return nil, fmt.Errorf("--files is required: comma-separated paths of the review group")
+	}
+	byPath := make(map[string]model.Diff, len(selected))
+	for _, d := range selected {
+		byPath[d.NewPath] = d
+	}
+	group := make([]model.Diff, 0, len(want))
+	for _, p := range want {
+		d, ok := byPath[p]
+		if !ok || d.IsDeleted {
+			return nil, fmt.Errorf("%s is not a reviewable file of this change set", p)
+		}
+		group = append(group, d)
+	}
+	return group, nil
+}
+
+func runCoreRender(opts coreOptions, phase string) error {
+	if phase != "main" && phase != "plan" && phase != "filter" {
+		return fmt.Errorf("unknown render phase %q: expected one of main, plan, filter", phase)
+	}
+	cc, set, err := loadCoreSet(opts)
+	if err != nil {
+		return err
+	}
+	group, err := pickCoreGroup(set.Selected, opts.files)
+	if err != nil {
+		return err
+	}
+	r := agent.CoreRender{Args: coreAgentArgs(cc, opts), Retained: set.Retained, Group: group}
+	if opts.date != "" {
+		if r.Now, err = time.ParseInLocation("2006-01-02 15:04", opts.date, time.Local); err != nil {
+			return fmt.Errorf("invalid --date %q: want \"2006-01-02 15:04\"", opts.date)
+		}
+	}
+
+	out := coreRenderOutput{Phase: phase}
+	for _, d := range group {
+		out.Files = append(out.Files, d.NewPath)
+	}
+	out.GroupKey = coreGroupKey(out.Files)
+
+	switch phase {
+	case "plan":
+		if r.Args.PlanToolDefs, err = coreToolDefs(cc.Template, "plan"); err != nil {
+			return err
+		}
+		out.Messages, err = agent.RenderPlanMessages(r)
+	case "main":
+		if opts.planFile != "" {
+			data, readErr := os.ReadFile(opts.planFile)
+			if readErr != nil {
+				return fmt.Errorf("read --plan-file: %w", readErr)
+			}
+			r.Plan = strings.TrimRight(string(data), "\r\n")
+		}
+		if r.Confirmed, err = readCoreCommentsFile(opts.confirmedFile); err != nil {
+			return fmt.Errorf("read --confirmed-file: %w", err)
+		}
+		if out.Tools, err = coreToolDefs(cc.Template, "main"); err != nil {
+			return err
+		}
+		out.Messages, err = agent.RenderMainMessages(r)
+	case "filter":
+		if r.Comments, err = readCoreCommentsFile(opts.commentsFile); err != nil {
+			return fmt.Errorf("read --comments-file: %w", err)
+		}
+		if len(r.Comments) == 0 {
+			return fmt.Errorf("--comments-file must hold at least one candidate comment")
+		}
+		for i, c := range r.Comments {
+			out.CommentIDs = append(out.CommentIDs, coreFilterID{ID: fmt.Sprintf("c-%d", i), Path: c.Path})
+		}
+		out.Tools = agent.FilterToolDefs()
+		out.Messages, err = agent.RenderFilterMessages(r)
+	}
+	if err != nil {
+		return err
+	}
+	return writeCoreJSON(out)
+}
+
+// coreGroupKey matches the review's group key: the single path, or the sorted
+// paths joined by commas.
+func coreGroupKey(paths []string) string {
+	if len(paths) == 1 {
+		return paths[0]
+	}
+	sorted := append([]string(nil), paths...)
+	sort.Strings(sorted)
+	return strings.Join(sorted, ",")
+}
