+func phaseConversation(tpl *template.Template, phase string) (*template.LlmConversation, error) {
+	switch phase {
+	case "main":
+		return &tpl.MainTask, nil
+	case "plan":
+		return tpl.PlanTask, nil
+	case "filter":
+		return tpl.ReviewFilterTask, nil
+	case "relocation":
+		return tpl.ReLocationTask, nil
+	case "grouping":
+		return tpl.GroupingTask, nil
+	case "memory_compression":
+		return &tpl.MemoryCompressionTask, nil
+	}
+	return nil, fmt.Errorf("unknown prompt phase %q: expected one of %s", phase, strings.Join(corePhases, ", "))
+}
+
+func runCorePrompt(phase string) error {
+	tpl, err := template.LoadDefault()
+	if err != nil {
+		return fmt.Errorf("load default template: %w", err)
+	}
+	conv, err := phaseConversation(tpl, phase)
+	if err != nil {
+		return err
+	}
+	msgs := make([]llm.Message, 0)
+	if conv != nil {
+		for _, m := range conv.Messages {
+			msgs = append(msgs, llm.NewTextMessage(m.Role, m.Content))
+		}
+	}
+	return writeCoreJSON(msgs)
+}
+
+func coreToolDefs(tpl *template.Template, phase string) ([]llm.ToolDef, error) {
+	switch phase {
+	case "main":
+		return loadToolDefs(tpl.MainTask.Tools)
+	case "plan":
+		if tpl.PlanTask == nil {
+			return []llm.ToolDef{}, nil
+		}
+		return loadToolDefs(tpl.PlanTask.ToolReferences)
+	case "filter":
+		return agent.FilterToolDefs(), nil
+	}
+	return nil, fmt.Errorf("unknown tool phase %q: expected one of main, plan, filter", phase)
+}
+
+func runCoreTools(phase string) error {
+	tpl, err := template.LoadDefault()
+	if err != nil {
+		return fmt.Errorf("load default template: %w", err)
+	}
+	defs, err := coreToolDefs(tpl, phase)
+	if err != nil {
+		return err
+	}
+	return writeCoreJSON(defs)
+}
